# Copy to server/deploy/.env (never commit the real file).
# Use a DNS name covered by the mounted certificate.
ASGEND_CP_PUBLIC_HOST=asgend.example.com
ASGEND_CP_ALLOWED_HOSTS=localhost,127.0.0.1,asgend.example.com
ASGEND_CP_TLS_DIR=./tls
ASGEND_CP_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
ASGEND_CP_HTTP_PORT=80
ASGEND_CP_HTTPS_PORT=443
ASGEND_CP_LOG_LEVEL=INFO
